{
  "name": "sessionary",
  "version": "0.1.0",
  "description": "Local-first session manager for AI coding agents: browse, search and resume Claude Code, OpenCode and Pi sessions",
  "keywords": [
    "claude-code",
    "opencode",
    "pi",
    "ai-agents",
    "sessions",
    "local-first",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onlynor/Sessionary.git"
  },
  "homepage": "https://github.com/onlynor/Sessionary#readme",
  "bugs": {
    "url": "https://github.com/onlynor/Sessionary/issues"
  },
  "type": "module",
  "license": "MIT",
  "bin": {
    "sessionary": "dist/cli.js"
  },
  "files": [
    "dist",
    "web-dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:server": "tsx watch src/cli.ts --no-open",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "pnpm run build:server && pnpm run build:web",
    "build:server": "tsup src/cli.ts --format esm --target node22 --out-dir dist --clean",
    "build:web": "vite build --config web/vite.config.ts",
    "build:design": "node design/playground/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "highlight.js": "^11.10.0",
    "lucide-react": "^1.51.0",
    "lucide-static": "^1.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "packageManager": "pnpm@11.15.1"
}
